{
  "title": "Sample app control plane",
  "version": 1,
  "dialect": "https://json-schema.org/draft/2020-12/schema",
  "request_headers": {
    "control": {
      "applies_to": "every /__playground request",
      "schema": {
        "type": "object",
        "properties": {
          "Authorization": {
            "type": "string"
          },
          "X-Playground-Run": {
            "type": "string"
          }
        },
        "required": [
          "Authorization"
        ],
        "additionalProperties": false
      }
    },
    "visitor": {
      "applies_to": "a visitor's POST /api/action and POST /api/confirm",
      "schema": {
        "type": "object",
        "properties": {
          "X-Playground-Ref": {
            "type": "string"
          },
          "X-Forwarded-For": {
            "type": "string"
          },
          "X-Playground-Run": {
            "type": "string"
          }
        },
        "required": [
          "X-Playground-Ref",
          "X-Forwarded-For"
        ],
        "additionalProperties": false
      }
    }
  },
  "routes": {
    "health": {
      "method": "GET",
      "path": "/__playground/health",
      "request": null,
      "responses": {
        "200": {
          "body": {
            "type": "object",
            "properties": {
              "boot_id": {
                "type": "string"
              },
              "sdk": {
                "const": "signalgate"
              },
              "sdk_version": {
                "type": "string"
              },
              "methods": {
                "type": "array",
                "items": {
                  "enum": [
                    "playground.action",
                    "playground.success"
                  ]
                }
              },
              "clients_created": {
                "type": "integer"
              },
              "client_ready": {
                "type": "boolean"
              },
              "self_test": {
                "type": "object",
                "properties": {
                  "ok": {
                    "type": "boolean"
                  },
                  "failed": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "sdk_version",
                        "transport_import",
                        "transport_signature",
                        "transport_protocol",
                        "facade",
                        "client_hook",
                        "probe_hooks",
                        "exit_hook"
                      ]
                    }
                  },
                  "checks": {
                    "type": "object",
                    "properties": {
                      "sdk_version": {
                        "enum": [
                          "pass",
                          "fail",
                          "skip"
                        ]
                      },
                      "transport_import": {
                        "enum": [
                          "pass",
                          "fail",
                          "skip"
                        ]
                      },
                      "transport_signature": {
                        "enum": [
                          "pass",
                          "fail",
                          "skip"
                        ]
                      },
                      "transport_protocol": {
                        "enum": [
                          "pass",
                          "fail",
                          "skip"
                        ]
                      },
                      "facade": {
                        "enum": [
                          "pass",
                          "fail",
                          "skip"
                        ]
                      },
                      "client_hook": {
                        "enum": [
                          "pass",
                          "fail",
                          "skip"
                        ]
                      },
                      "probe_hooks": {
                        "enum": [
                          "pass",
                          "fail",
                          "skip"
                        ]
                      },
                      "exit_hook": {
                        "enum": [
                          "pass",
                          "fail",
                          "skip"
                        ]
                      }
                    },
                    "required": [
                      "sdk_version",
                      "transport_import",
                      "transport_signature",
                      "transport_protocol",
                      "facade",
                      "client_hook",
                      "probe_hooks",
                      "exit_hook"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "ok",
                  "failed",
                  "checks"
                ],
                "additionalProperties": false
              },
              "key": {
                "enum": [
                  "absent",
                  "placeholder",
                  "invalid",
                  "set"
                ]
              }
            },
            "required": [
              "boot_id",
              "sdk",
              "sdk_version",
              "methods",
              "clients_created",
              "client_ready",
              "self_test",
              "key"
            ],
            "additionalProperties": false
          }
        },
        "401": {
          "body": {
            "type": "object",
            "properties": {
              "detail": {
                "const": "unauthorized"
              }
            },
            "required": [
              "detail"
            ],
            "additionalProperties": false
          }
        },
        "403": {
          "body": {
            "type": "object",
            "properties": {
              "detail": {
                "const": "forbidden"
              }
            },
            "required": [
              "detail"
            ],
            "additionalProperties": false
          }
        }
      }
    },
